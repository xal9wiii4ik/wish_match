# Base URL of the WishMatch API (without trailing slash).
# In dev, requests to /v1 are proxied to VITE_DEV_API_PROXY (see below),
# so the default empty value lets the Vite proxy handle routing.
VITE_API_BASE_URL=

# Target backend used by the Vite dev proxy for /v1 requests.
VITE_DEV_API_PROXY=http://localhost:8000

# Toggle the in-memory mock layer for domain endpoints that the backend
# does not implement yet (wishes, swipes, matches, profile, categories).
# Auth always talks to the real backend. Set to "false" once the backend
# exposes these endpoints.
VITE_USE_MOCKS=true

# Default map center (used when a user has no location yet). Moscow center.
VITE_DEFAULT_MAP_LAT=55.751244
VITE_DEFAULT_MAP_LNG=37.618423
